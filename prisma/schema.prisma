// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String?  @unique
  username   String   @unique
  password   String
  firstName  String
  lastName   String?
  type       String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  birthDate DateTime?
  parentId  Int?

  parent        User?          @relation("ParentChildren", fields: [parentId], references: [id])
  children      User[]         @relation("ParentChildren")
  fcmToken      String?
  conversations Conversation[]

  readingLevel   String?
  responseLength String?
  learningStyle  String?
  interests      String[]
  blockedTopics  String[]
  gender         String?
  tokenBalance   Int      @default(100000)
  usedTokens     Int      @default(0)
  stories        Story[]
  uploadedDocuments Document[]
  answers StoryAnswer[]
  documents ChildDocument[]
  reports StoryReport[]

  createdChallenges Challenge[]

  challengeParticipations ChallengeParticipant[]

  challengeAnswers ChallengeAnswer[]
  vectorStoreId   String?
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    Int
  otp       String
  type      String
  expiresAt DateTime
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Question {
  id               Int      @id @default(autoincrement())
  question         String
  imageDescription String?
  voiceText        String?
  answer           String
  imageUrl         String?
  audioUrl         String?
  // childId          Int
  conversationId   Int
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  responseMode     String @default("normal")

  journeyData      Json?

  analytics QuestionAnalytics?
}

model Conversation {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String?
  createdAt    DateTime @default(now())
  lastActivity DateTime @default(now())

  questions Question[]
}

model TokenUsage {
  id Int @id @default(autoincrement())

  parentId Int
  childId  Int

  inputTokens  Int
  outputTokens Int
  totalTokens  Int

  createdAt DateTime @default(now())
}

enum StoryStatus {
  DRAFT
  PUBLISHED
}

model Story {
  id      Int    @id @default(autoincrement())
  title   String
  content String

  educationalGoal String
  storyType       String
  storyLength     String

  hasImages Boolean @default(false)
  hasAudio  Boolean @default(false)

  audioUrl String?

  status StoryStatus @default(DRAFT)

  childId Int
  child   User @relation(fields: [childId], references: [id])

  scenes       StoryScene[]
  editMessages StoryEditMessage[]
  questions    StoryQuestion[]
  answers      StoryAnswer[]
  reports      StoryReport[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isApproved           Boolean @default(false)

  questionsApproved    Boolean @default(false)
}

model StoryScene {
  id Int @id @default(autoincrement())

  storyId Int
  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  sceneOrder Int

  title   String?
  content String

  imagePrompt String?
  imageUrl    String?

  createdAt DateTime @default(now())

  audioUrl String?

  duration Float?

  startTime Float?
  endTime Float?
}

model StoryEditMessage {
  id Int @id @default(autoincrement())

  storyId Int

  role    String
  content String

  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model Document {
  id Int @id @default(autoincrement())

  title String
  fileName String
  fileUrl String

  openaiFileId String

  uploadedById Int
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  children ChildDocument[]
}

model ChildDocument {
  childId Int
  documentId Int

  child User @relation(fields: [childId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([childId, documentId])
}

model StoryQuestion {
  id          Int      @id @default(autoincrement())

  storyId     Int
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  question    String

  answers     StoryAnswer[]
  expectedAnswer String?

  audioUrl       String?
  audioDuration  Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoryAnswer {
  id Int @id @default(autoincrement())

  storyId Int
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  questionId Int
  question StoryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  childId Int
  child User @relation(fields: [childId], references: [id])

  answer String

  createdAt DateTime @default(now())
  evaluation StoryAnswerEvaluation?

}

model StoryAnswerEvaluation {
  id Int @id @default(autoincrement())

  answerId Int @unique

  answer StoryAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  score Int

  feedback String

  createdAt DateTime @default(now())
}

model StoryReport {
  id Int @id @default(autoincrement())

  storyId Int
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  childId Int
  child User @relation(fields: [childId], references: [id], onDelete: Cascade)

  overallScore Int

  summary String

  goalAchievement Int

  strengths String[]

  improvements String[]

  createdAt DateTime @default(now())
}

model QuestionAnalytics {
  id Int @id @default(autoincrement())

  questionId Int @unique
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  category String?
  subcategory String?

  curiosityScore Int @default(0)
  creativityScore Int @default(0)
  analyticalScore Int @default(0)

  emotionalSignal String?

  skills String[]

  createdAt DateTime @default(now())
}

model ChildDailyReport {
  id Int @id @default(autoincrement())

  childId Int

  topCategories String[]
  topSubcategories String[]

  curiosityAvg Float
  creativityAvg Float
  analyticalAvg Float

  emotionalSummary String?
  recommendations String[]

  insights Json

  createdAt DateTime @default(now())
}

model Challenge {
  id Int @id @default(autoincrement())

  parentId Int

  title String

  description String?

  startAt DateTime

  endAt DateTime

  createdAt DateTime @default(now())

  parent User @relation(fields:[parentId],references:[id])

  participants ChallengeParticipant[]

  questions ChallengeQuestion[]

  answer    ChallengeAnswer[]
}

model ChallengeParticipant {
  challengeId Int

  childId Int

  totalScore Int @default(0)

  completedAt DateTime?

  challenge Challenge @relation(fields:[challengeId],references:[id],onDelete:Cascade)

  child User @relation(fields:[childId],references:[id])

  @@id([challengeId, childId])
}

model ChallengeQuestion {
  id Int @id @default(autoincrement())

  challengeId Int

  question String

  expectedAnswer String

  points Int

  createdAt DateTime @default(now())

  challenge Challenge @relation(fields:[challengeId],references:[id],onDelete:Cascade)

  answers ChallengeAnswer[]
}

model ChallengeAnswer {
  id Int @id @default(autoincrement())

  challengeId Int

  questionId Int

  childId Int

  answer String

  isCorrect Boolean?

  earnedPoints Int @default(0)

  submittedAt DateTime @default(now())

  question ChallengeQuestion @relation(fields:[questionId],references:[id])

  challenge Challenge @relation(fields:[challengeId],references:[id], onDelete:Cascade)

  child User @relation(fields:[childId],references:[id])

  @@unique([questionId, childId])
}