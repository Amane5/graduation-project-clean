// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String?  @unique
  username   String   @unique
  password   String
  firstName  String
  lastName   String?
  type       String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  birthDate DateTime?
  parentId  Int?

  parent        User?          @relation("ParentChildren", fields: [parentId], references: [id])
  children      User[]         @relation("ParentChildren")
  fcmToken      String?
  conversations Conversation[]

  readingLevel   String?
  responseLength String?
  learningStyle  String?
  interests      String[]
  blockedTopics  String[]
  gender         String?
  tokenBalance   Int      @default(100000)
  usedTokens     Int      @default(0)
  stories        Story[]
  uploadedDocuments Document[]
  answers StoryAnswer[]
  documents ChildDocument[]
  vectorStoreId   String?
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    Int
  otp       String
  type      String
  expiresAt DateTime
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Question {
  id               Int      @id @default(autoincrement())
  question         String
  imageDescription String?
  voiceText        String?
  answer           String
  imageUrl         String?
  audioUrl         String?
  // childId          Int
  conversationId   Int
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Conversation {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String?
  createdAt    DateTime @default(now())
  lastActivity DateTime @default(now())

  questions Question[]
}

model TokenUsage {
  id Int @id @default(autoincrement())

  parentId Int
  childId  Int

  inputTokens  Int
  outputTokens Int
  totalTokens  Int

  createdAt DateTime @default(now())
}

enum StoryStatus {
  DRAFT
  PUBLISHED
}

model Story {
  id      Int    @id @default(autoincrement())
  title   String
  content String

  educationalGoal String
  storyType       String
  storyLength     String

  hasImages Boolean @default(false)
  hasAudio  Boolean @default(false)

  audioUrl String?

  status StoryStatus @default(DRAFT)

  childId Int
  child   User @relation(fields: [childId], references: [id])

  scenes       StoryScene[]
  editMessages StoryEditMessage[]
  questions    StoryQuestion[]
  answers      StoryAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isApproved           Boolean @default(false)

  questionsApproved    Boolean @default(false)
}

model StoryScene {
  id Int @id @default(autoincrement())

  storyId Int
  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  sceneOrder Int

  title   String?
  content String

  imagePrompt String?
  imageUrl    String?

  createdAt DateTime @default(now())

  startTime   Float?   
  endTime     Float? 
}

model StoryEditMessage {
  id Int @id @default(autoincrement())

  storyId Int

  role    String
  content String

  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model Document {
  id Int @id @default(autoincrement())

  title String
  fileName String
  fileUrl String

  openaiFileId String

  uploadedById Int
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  children ChildDocument[]
}

model ChildDocument {
  childId Int
  documentId Int

  child User @relation(fields: [childId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([childId, documentId])
}

model StoryQuestion {
  id          Int      @id @default(autoincrement())

  storyId     Int
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  question    String
  answers StoryAnswer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoryAnswer {
  id Int @id @default(autoincrement())

  storyId Int
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  questionId Int
  question StoryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  childId Int
  child User @relation(fields: [childId], references: [id])

  answer String

  createdAt DateTime @default(now())
}